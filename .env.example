# Core learning works with all optional values empty.
# For optional services, generate separate random tokens: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKEN=
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# OpenAI-compatible API base including /v1. The model must appear in GET /models.
# Example Ollama: http://host.docker.internal:11434/v1
# Example hosted gateway: https://your-provider.example/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Enable only with the labs profile on a dedicated lab Docker daemon.
RUNNER_URL=
RUNNER_TOKEN=
LAB_IMAGE=python:3.13-alpine
LAB_DOCKER_SOCKET=/var/run/docker.sock

# Optional image for real Bash behavior checks.
BASH_LAB_IMAGE=platform-forge-bash:0.2
